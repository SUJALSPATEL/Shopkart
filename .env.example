PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/shopkart?retryWrites=true&w=majority
jwt_secret=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:5173

# Razorpay Test Mode keys, from Dashboard > Account & Settings > API Keys.
# The server refuses to start a payment unless the key id begins with rzp_test_,
# so live keys are rejected here by design.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-with-your-razorpay-test-key-secret
